{
  "name": "fred-evaluation-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-toolchain.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "generate:api": "openapi-typescript ../fred-evaluation-backend/openapi.json -o src/shared/api/openapi.d.ts"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@fred-oss/design-tokens": "0.1.0-alpha.1",
    "@fred-oss/iframe-sdk": "0.1.0-alpha.3",
    "@fred-oss/ui": "0.1.0-alpha.4",
    "i18next": "25.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "15.5.3",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.13.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.40.0",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  }
}
