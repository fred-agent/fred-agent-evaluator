# Local secrets for the Fred evaluation API and worker
# ====================================================
#
# First-time setup:
#
#   cp config/.env.template config/.env
#
# Then edit `config/.env` (not this template). The real `.env` is ignored by Git;
# never commit it, paste its values into an issue, or share it in chat.
#
# The API and worker both load `config/.env` through ENV_FILE. The Make targets
# (`make run` and `make run-worker`) set ENV_FILE automatically, then the shared
# FRED loader reads CONFIG_FILE from this `.env` before selecting the YAML file.
#
# Minimal default setup
# ---------------------
# The shipped configuration uses Mistral for the evaluation judge and campaign
# analysis. A new local user normally needs to fill only MISTRAL_API_KEY below.
# Other variables are conditional and may remain empty unless their corresponding
# feature is enabled in configuration.yaml.

# Mistral model provider
# ----------------------
# Paste an API key issued by Mistral Studio. This is a secret credential, not a
# model name such as `mistral-small`, and not a URL.
#
# Some other FRED applications may store the same Mistral-issued credential under
# OPENAI_API_KEY because they use an OpenAI-compatible client. Environment-variable
# names are application configuration: this evaluator explicitly reads
# MISTRAL_API_KEY. If your existing OPENAI_API_KEY value was issued by Mistral, you
# may copy the same value here. If it was issued by OpenAI, it is not interchangeable.
MISTRAL_API_KEY=""

# Evaluator service identity (conditional)
# ----------------------------------------
# Required only when `security.m2m.enabled: true`. This is the secret of the
# dedicated Keycloak confidential client named `fred-evaluation-worker`, normally
# provisioned by fred-deployment-factory. It is unrelated to MISTRAL_API_KEY.
#
# Do not reuse an agentic, control-plane, knowledge-flow, public-client, user, or
# administrator credential here.
KEYCLOAK_EVAL_WORKER_CLIENT_SECRET=""

# Database (conditional)
# ----------------------
# Required by configuration_prod.yaml when PostgreSQL is used. Leave empty for
# the default local SQLite database in configuration.yaml.
FRED_POSTGRES_PASSWORD=""

# Observability (optional)
# ------------------------
# Required only for Langfuse trace export and UI links. These are Langfuse project
# credentials, not LLM-provider keys. Without both values, the evaluator logs that
# Langfuse tracing is disabled and continues running.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Alternative model providers (optional)
# --------------------------------------
# OPENAI_API_KEY is read only when you configure an OpenAI judge or analysis
# profile whose `api_key_env` points to OPENAI_API_KEY. It is not needed by the
# shipped Mistral profiles.
OPENAI_API_KEY=""

# LiteLLM is the routing library used by the evaluator; using that library does
# not itself require a LiteLLM key. Fill this only when you deliberately configure
# `api_key_env: LITELLM_API_KEY`, typically for an authenticated LiteLLM Proxy or
# another custom endpoint. For the default Mistral setup, leave it empty.
LITELLM_API_KEY=""

# Vertex AI profiles use Google Application Default Credentials for authentication;
# these optional values select the project and region.
VERTEXAI_PROJECT=""
VERTEXAI_LOCATION=""

# Process settings (optional)
# ---------------------------
# Select the YAML configuration used by `make run` and `make run-worker`.
# Leave unset/commented for the local development fallback
# (./config/configuration.yaml: SQLite and authentication disabled).
# Uncomment for the Docker Compose / production-like profile. Both the API and
# worker will then use configuration_prod.yaml without requiring special targets.
# CONFIG_FILE="./config/configuration_prod.yaml"

# API documentation endpoints are enabled by default. Uncomment for production
# hardening when those endpoints must not be exposed.
# PRODUCTION_FASTAPI_DOCS_ENABLED="false"
