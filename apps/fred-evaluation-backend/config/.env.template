# Copy this file to `config/.env` and fill only the values required by the
# configuration and model providers you enable. `config/.env` is ignored by Git;
# never commit real credentials.
#
#   cp config/.env.template config/.env
#
# The evaluator API and worker load this file through ENV_FILE. The Make targets
# already set ENV_FILE to this directory.

# Default judge and campaign-analysis model in configuration.yaml and
# configuration_prod.yaml. Required when using either configured Mistral profile.
MISTRAL_API_KEY=""

# Dedicated Keycloak confidential-client secret for `fred-evaluation-worker`.
# Required only when `security.m2m.enabled: true`.
# Use the secret provisioned for this exact client; do not reuse the agentic,
# control-plane, knowledge-flow, user, or admin client secret.
KEYCLOAK_EVAL_WORKER_CLIENT_SECRET=""

# PostgreSQL password used by configuration_prod.yaml. Not required by the
# default SQLite development configuration.
FRED_POSTGRES_PASSWORD=""

# Langfuse credentials. Required only when `observability.tracer: langfuse` and
# trace export or Langfuse links are wanted. Without both values, tracing is
# disabled gracefully.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Optional model-provider credentials. Fill only when the corresponding judge
# or analysis profile is enabled in configuration.yaml.
OPENAI_API_KEY=""
LITELLM_API_KEY=""

# Optional Vertex AI settings. Authentication itself uses Google Application
# Default Credentials; these select the project and region for a Vertex profile.
VERTEXAI_PROJECT=""
VERTEXAI_LOCATION=""

# Optional startup override. The Make targets already default to
# ./config/configuration.yaml, so most local users should leave this commented.
# CONFIG_FILE="./config/configuration_prod.yaml"

# Optional production hardening flag. Documentation endpoints are enabled by
# default; set to false to disable them.
# PRODUCTION_FASTAPI_DOCS_ENABLED="false"
